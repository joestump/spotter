package auth

import "spotter/internal/views/layouts"

templ Login(navidromeURL string, errorMsg string) {
	@layouts.Base("Login | Spotter") {
		<div class="hero min-h-screen bg-base-200 relative overflow-hidden">
			<!-- Ambient brand glow: green + violet, the Spotter energy -->
			<div class="absolute -top-40 -left-40 w-[32rem] h-[32rem] rounded-full bg-primary/20 blur-3xl"></div>
			<div class="absolute -bottom-40 -right-40 w-[32rem] h-[32rem] rounded-full bg-secondary/20 blur-3xl"></div>
			<div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-72 h-72 rounded-full bg-primary/10 blur-3xl"></div>
			<div class="hero-content flex-col relative z-10 w-full px-4">
				<!-- Wordmark lockup -->
				<div class="flex items-center gap-3 mb-2">
					<div class="relative">
						<span class="icon-[heroicons--musical-note] w-11 h-11 text-primary drop-shadow-[0_0_16px_rgba(31,223,110,0.6)]"></span>
						<span class="absolute inset-0 icon-[heroicons--musical-note] w-11 h-11 text-primary opacity-40 blur-md"></span>
					</div>
					<h1 class="text-5xl brand-wordmark text-primary">Spotter</h1>
				</div>
				<p class="text-sm text-base-content/50 mb-6 tracking-tight">AI music discovery for your Navidrome library</p>
				<div class="card w-full max-w-md rounded-2xl shadow-2xl bg-base-100 border border-base-300">
					<div class="card-body gap-0">
						<div class="mb-6">
							<h2 class="text-2xl font-bold tracking-tight">Welcome back</h2>
							<p class="text-sm text-base-content/50 mt-1">Sign in to pick up where you left off.</p>
						</div>
						if errorMsg != "" {
							<div class="alert alert-error rounded-xl shadow-sm mb-4">
								<span class="icon-[heroicons--exclamation-triangle] w-5 h-5"></span>
								<span>{ errorMsg }</span>
							</div>
						}
						<form class="space-y-4" action="/login" method="POST" hx-post="/login" hx-target="body">
							<div class="form-control">
								<label class="label pb-1" for="username">
									<span class="label-text font-semibold tracking-tight">Username</span>
								</label>
								<div class="relative">
									<span class="icon-[heroicons--user] w-5 h-5 text-base-content/40 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></span>
									<input
										id="username"
										name="username"
										type="text"
										placeholder="Enter your username"
										autocomplete="username"
										required
										class="input input-bordered w-full pl-11 rounded-xl focus:input-primary"
										autofocus
									/>
								</div>
							</div>
							<div class="form-control">
								<label class="label pb-1" for="password">
									<span class="label-text font-semibold tracking-tight">Password</span>
								</label>
								<div class="relative">
									<span class="icon-[heroicons--lock-closed] w-5 h-5 text-base-content/40 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></span>
									<input
										id="password"
										name="password"
										type="password"
										placeholder="Enter your password"
										autocomplete="current-password"
										required
										class="input input-bordered w-full pl-11 rounded-xl focus:input-primary"
									/>
								</div>
							</div>
							<div class="form-control pt-2">
								<button type="submit" class="btn btn-primary btn-lg w-full gap-2">
									<span class="icon-[heroicons--arrow-right-on-rectangle] w-5 h-5"></span>
									Log in with Navidrome
								</button>
							</div>
						</form>
						<div class="divider text-xs text-base-content/30">CONNECTED SERVER</div>
						<div class="rounded-xl border border-base-300 bg-base-200/60 p-4">
							<div class="flex items-center gap-2.5 mb-2">
								<span class="icon-[heroicons--server-stack] w-5 h-5 text-primary flex-shrink-0"></span>
								<p class="font-semibold text-sm tracking-tight">Uses your Navidrome credentials</p>
							</div>
							<p class="text-xs text-base-content/50 leading-relaxed">Sign in with the same username and password you use for Navidrome. This Spotter instance is connected to:</p>
							<p class="text-xs mt-2.5 font-mono text-primary bg-primary/10 border border-primary/20 px-2.5 py-1.5 rounded-lg break-all">{ navidromeURL }</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
