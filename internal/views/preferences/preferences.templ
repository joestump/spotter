package preferences

import (
	"spotter/ent"
	"spotter/internal/config"
	"spotter/internal/views/layouts"
	"strconv"
)

templ Appearance(user *ent.User, cfg *config.Config) {
	@layouts.Dashboard("Appearance | Spotter", cfg, "/preferences/appearance") {
		<div class="max-w-5xl mx-auto">
			<header class="mb-8">
				<p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary/80">Preferences</p>
				<h2 class="text-3xl font-bold tracking-tight mt-1">Appearance</h2>
				<p class="text-base-content/60 mt-2">Tune the look and feel of your Spotter experience.</p>
			</header>
			<div class="space-y-6">
				<!-- Theme Settings Card -->
				<div class="card bg-base-100 border border-base-300 rounded-2xl shadow-xl">
					<div class="card-body">
						<div class="flex items-center gap-3">
							<span class="grid place-items-center w-11 h-11 rounded-xl bg-primary/10 text-primary shrink-0">
								<span class="icon-[heroicons--paint-brush] w-6 h-6"></span>
							</span>
							<div>
								<h3 class="text-lg font-bold tracking-tight">Theme &amp; Display</h3>
								<p class="text-sm text-base-content/60">Colors, density, and how much fits on a page.</p>
							</div>
						</div>
						<form id="preferences-form" hx-post="/preferences/appearance" hx-swap="none" class="space-y-6 mt-6">
							<!-- Theme Selection -->
							<div class="form-control">
								<label class="label">
									<span class="label-text font-semibold">Theme</span>
									<span class="label-text-alt text-base-content/60">Choose your preferred color scheme</span>
								</label>
								<select
									name="theme"
									id="theme-select"
									class="select select-bordered w-full rounded-xl"
									onchange="applyTheme(this.value)"
								>
									for _, theme := range cfg.AvailableThemes() {
										<option value={ theme } selected?={ user.Theme == theme }>{ theme }</option>
									}
								</select>
							</div>
							<!-- Pagination Size -->
							<div class="form-control">
								<label class="label">
									<span class="label-text font-semibold">Items Per Page</span>
									<span class="label-text-alt text-base-content/60">Number of items to show per page</span>
								</label>
								<input
									type="number"
									name="pagination_size"
									value={ strconv.Itoa(user.PaginationSize) }
									min="10"
									max="100"
									step="5"
									class="input input-bordered w-full max-w-xs rounded-xl"
								/>
							</div>
							<div class="card-actions justify-end pt-2">
								<button type="submit" class="btn btn-primary gap-2">
									<span class="icon-[heroicons--check] w-5 h-5"></span>
									Save Settings
								</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
		<script>
			// Apply theme immediately when changed
			function applyTheme(theme) {
				document.documentElement.setAttribute('data-theme', theme);
				localStorage.setItem('spotter-theme', theme);
			}

			// Show toast notification using safe DOM APIs (no innerHTML)
			function showToast(message, type) {
				const container = document.getElementById('toasts');
				if (!container) return;

				const toast = document.createElement('div');
				toast.className = 'alert shadow-lg';

				let iconClass, alertClass;
				if (type === 'success') {
					alertClass = 'alert-success';
					iconClass = 'icon-[heroicons--check-circle]';
				} else {
					alertClass = 'alert-error';
					iconClass = 'icon-[heroicons--x-circle]';
				}

				toast.classList.add(alertClass);

				const icon = document.createElement('span');
				icon.className = iconClass + ' w-6 h-6';

				const text = document.createElement('span');
				text.textContent = message;

				toast.appendChild(icon);
				toast.appendChild(text);
				container.appendChild(toast);

				// Auto-remove after 4 seconds
				setTimeout(() => {
					toast.style.opacity = '0';
					toast.style.transition = 'opacity 0.3s ease-out';
					setTimeout(() => toast.remove(), 300);
				}, 4000);
			}

			// Handle form submission
			const form = document.getElementById('preferences-form');
			if (form) {
				form.addEventListener('htmx:afterRequest', function(event) {
					if (event.detail.successful) {
						showToast('Settings saved successfully!', 'success');
					} else {
						showToast('Failed to save settings. Please try again.', 'error');
					}
				});
			}
		</script>
	}
}
