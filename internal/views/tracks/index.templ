package tracks

import (
	"fmt"
	"net/url"
	"spotter/ent"
	"spotter/internal/config"
	"spotter/internal/views/components"
	"spotter/internal/views/layouts"
)

func buildTrackPaginationURL(page int, artistFilter, sortCol, sortDir string) string {
	u := fmt.Sprintf("/library/tracks?page=%d", page)
	if artistFilter != "" {
		u += "&artist=" + url.QueryEscape(artistFilter)
	}
	if sortCol != "" {
		u += "&sort=" + sortCol + "&dir=" + sortDir
	}
	return u
}

func buildTrackSortBaseURL(currentPage int, artistFilter string) string {
	u := fmt.Sprintf("/library/tracks?page=%d", currentPage)
	if artistFilter != "" {
		u += "&artist=" + url.QueryEscape(artistFilter)
	}
	return u
}

func toTrackRows(tracks []*ent.Track, lidarrBaseURL string) []components.TrackTableRow {
	rows := make([]components.TrackTableRow, len(tracks))
	for i, t := range tracks {
		rows[i] = components.TrackTableRow{
			Track:         t,
			LidarrBaseURL: lidarrBaseURL,
		}
	}
	return rows
}

templ Index(tracks []*ent.Track, currentPage int, totalPages int, cfg *config.Config, artistFilter, sortCol, sortDir string) {
	@layouts.Dashboard("Tracks | Spotter", cfg, "/library/tracks") {
		<div class="max-w-7xl mx-auto">
			<header class="mb-8">
				<div class="flex items-center gap-2 text-primary mb-2">
					<span class="icon-[heroicons--musical-note] w-5 h-5"></span>
					<span class="text-xs font-semibold uppercase tracking-widest">Library</span>
				</div>
				<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-base-content">Tracks</h1>
				if artistFilter != "" {
					<p class="text-base-content/60 mt-2 flex flex-wrap items-center gap-2">
						Filtered by artist
						<span class="badge badge-primary badge-outline font-medium">{ artistFilter }</span>
						<a href="/library/tracks" class="link link-primary text-sm">Clear filter</a>
					</p>
				} else {
					<p class="text-base-content/60 mt-2">Every track from your enriched music catalog, ready to explore.</p>
				}
			</header>
			if len(tracks) == 0 {
				<div class="card bg-base-100 border border-base-300 rounded-2xl">
					<div class="card-body items-center text-center py-16">
						<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center mb-2">
							<span class="icon-[heroicons--musical-note] w-10 h-10 text-primary"></span>
						</div>
						if artistFilter != "" {
							<h3 class="text-xl font-bold tracking-tight">No tracks found for this artist</h3>
							<p class="text-base-content/60 max-w-sm">Try clearing the filter to see all tracks in your library.</p>
							<a href="/library/tracks" class="btn btn-primary mt-4">Clear Filter</a>
						} else {
							<h3 class="text-xl font-bold tracking-tight">No tracks yet</h3>
							<p class="text-base-content/60 max-w-sm">Tracks will appear here once your music catalog is enriched.</p>
						}
					</div>
				</div>
			} else {
				<div class="card bg-base-100 border border-base-300 rounded-2xl shadow-xl">
					<div class="card-body">
						<div class="flex items-center justify-between mb-4">
							<div>
								<h2 class="text-lg font-bold tracking-tight flex items-center gap-2">
									<span class="icon-[heroicons--queue-list] w-5 h-5 text-primary"></span>
									All Tracks
								</h2>
								if artistFilter != "" {
									<p class="text-base-content/60 text-sm mt-1">
										Showing tracks by <span class="font-medium text-primary">{ artistFilter }</span>
									</p>
								} else {
									<p class="text-base-content/60 text-sm mt-1">Sortable, filterable, and always in sync</p>
								}
							</div>
							<div class="flex items-center gap-2">
								@components.TrackTableToolbar(components.TrackTableToolbarConfig{
									TableID:           "tracks-table",
									ShowArtworkToggle: true,
									ArtworkDefault:    true,
									ColumnOptions: []components.ColumnOption{
										{Value: "col-track", Label: "Track", DefaultVisible: true},
										{Value: "col-artist", Label: "Artist", DefaultVisible: true},
										{Value: "col-album", Label: "Album", DefaultVisible: true},
										{Value: "col-duration", Label: "Duration", DefaultVisible: true},
										{Value: "col-popularity", Label: "Popularity", DefaultVisible: true},
										{Value: "col-plays", Label: "Plays", DefaultVisible: false},
									},
								})
							</div>
						</div>
						@components.TrackTable("tracks-table", toTrackRows(tracks, cfg.Lidarr.BaseURL), []string{"track", "artist", "album", "duration", "popularity"}, nil, components.SortConfig{
							Column:    sortCol,
							Direction: sortDir,
							BaseURL:   buildTrackSortBaseURL(currentPage, artistFilter),
						})
					</div>
				</div>
				if totalPages > 1 {
					<div class="flex justify-center mt-8">
						<div class="join bg-base-100 border border-base-300 rounded-full p-1">
							if currentPage > 1 {
								<a href={ templ.URL(buildTrackPaginationURL(currentPage-1, artistFilter, sortCol, sortDir)) } class="join-item btn btn-sm btn-ghost">«</a>
							} else {
								<button class="join-item btn btn-sm btn-ghost btn-disabled" disabled>«</button>
							}
							for i := 1; i <= totalPages; i++ {
								if i == currentPage {
									<button class="join-item btn btn-sm btn-primary">{ fmt.Sprintf("%d", i) }</button>
								} else if i == 1 || i == totalPages || (i >= currentPage-2 && i <= currentPage+2) {
									<a href={ templ.URL(buildTrackPaginationURL(i, artistFilter, sortCol, sortDir)) } class="join-item btn btn-sm btn-ghost">{ fmt.Sprintf("%d", i) }</a>
								} else if i == currentPage-3 || i == currentPage+3 {
									<button class="join-item btn btn-sm btn-ghost btn-disabled" disabled>...</button>
								}
							}
							if currentPage < totalPages {
								<a href={ templ.URL(buildTrackPaginationURL(currentPage+1, artistFilter, sortCol, sortDir)) } class="join-item btn btn-sm btn-ghost">»</a>
							} else {
								<button class="join-item btn btn-sm btn-ghost btn-disabled" disabled>»</button>
							}
						</div>
					</div>
				}
			}
		</div>
	}
}
