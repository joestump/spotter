// Governing: SPEC-0015 REQ playlist-pairing
package playlists

import (
	"fmt"
	"spotter/ent"
)

// NavidromeConflict renders an inline conflict resolution component when a Navidrome
// playlist with the same name already exists in Spotter's DB.
// Governing: SPEC-0015 REQ playlist-pairing
templ NavidromeConflict(pl *ent.Playlist, conflict *ent.Playlist) {
	<div id="playlist-conflict" class="card bg-base-100 border border-warning/40 rounded-2xl shadow-xl mt-4 overflow-hidden">
		<div class="h-1 bg-warning"></div>
		<div class="card-body gap-5">
			<div class="flex items-start gap-3">
				<div class="w-10 h-10 rounded-xl bg-warning/15 text-warning flex items-center justify-center shrink-0">
					<span class="icon-[heroicons--exclamation-triangle] w-6 h-6"></span>
				</div>
				<div>
					<p class="font-bold tracking-tight">Navidrome conflict detected</p>
					<p class="text-sm text-base-content/60 mt-0.5">
						A Navidrome playlist named <strong class="text-base-content">"{ conflict.Name }"</strong> already exists.
						Choose how to proceed:
					</p>
				</div>
			</div>
			<!-- Option 1: Pair with existing -->
			<form
				hx-post={ fmt.Sprintf("/playlists/%d/resolve-navidrome-conflict", pl.ID) }
				hx-target="#playlist-conflict"
				hx-swap="outerHTML"
				class="flex flex-wrap items-center gap-3 rounded-xl bg-base-200/60 p-4"
			>
				<input type="hidden" name="action" value="pair"/>
				<input type="hidden" name="existing_id" value={ conflict.RemoteID }/>
				<button type="submit" class="btn btn-sm btn-primary">
					<span class="icon-[heroicons--link] w-4 h-4"></span>
					Pair with existing
				</button>
				<span class="text-sm text-base-content/60">Links your playlist to the existing Navidrome one — no duplicate created</span>
			</form>
			<!-- Option 2: Use a different name -->
			<form
				hx-post={ fmt.Sprintf("/playlists/%d/resolve-navidrome-conflict", pl.ID) }
				hx-target="#playlist-conflict"
				hx-swap="outerHTML"
				class="flex flex-wrap items-center gap-3 rounded-xl bg-base-200/60 p-4"
			>
				<input type="hidden" name="action" value="new-name"/>
				<input
					type="text"
					name="name"
					placeholder="Enter Navidrome playlist name..."
					class="input input-sm input-bordered flex-1 min-w-48 rounded-full"
					required
				/>
				<button type="submit" class="btn btn-sm btn-outline btn-primary">
					<span class="icon-[heroicons--plus] w-4 h-4"></span>
					Create with this name
				</button>
			</form>
		</div>
	</div>
}
